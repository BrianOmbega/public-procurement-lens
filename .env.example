# Shared runtime configuration
PORT=3000
MCP_TRANSPORT=streamable-http
NODE_ENV=development

# Azure and local emulator configuration
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Procurement MCP service
ALLOWED_SOURCE_HOSTS=example.gov,opendata.go.ke
AUDIT_LOG_PATH=./data/audit-events.jsonl
REPORTS_PATH=./data/draft-reports.jsonl

# Agent runner
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
AGENT_AUDIT_URL=http://localhost:3000/api/audit-events

# Local development convenience
AZURITE_CONNECTION_STRING=UseDevelopmentStorage=true
